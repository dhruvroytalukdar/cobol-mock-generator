/target/
/ast/
/cobol-ast-cli.sh
/cobol-ast-cli.bat
/cobol-ast-server.sh
/cobol-ast-server.bat

# Python
__pycache__/
*.pyc
.pytest_cache/

# OS junk
.DS_Store

