# AST generator (external/local dependency — treated like an environment
# variable: required to run the pipeline, never committed to the repo)
/target/
/ast/
/cobol-ast-cli.sh
/cobol-ast-cli.bat
/cobol-ast-server.sh
/cobol-ast-server.bat

# Scratch workspace for dummy/temporary files created during a session
/scratch/

# AST server log files (produced when starting it via a redirected process)
/ast-server.log
/ast-server.err.log

# Python
__pycache__/
*.pyc
.pytest_cache/

# OS junk
.DS_Store

# Transformation output (regenerable from the source corpus via the pipeline;
# transformed/{aws,genapp}/ hold the AWS CardDemo and GenApp outputs). Not
# transformation logic, so it lives outside cobol_transformer/ and is never
# committed -- same treatment as judge_results/ below.
/transformed/

# Judge cases/results (generated per experiment run, not transformation
# logic) -- kept outside cobol_transformer/judge/ so that directory holds
# only code; see prepare_case.py's CASES_ROOT / run_judge.py's RESULTS_ROOT.
/judge_results/

# Instrumented variants and their binaries (regenerable from a testN.json plus
# the transformed source, exactly as transformed/ is regenerable from src)
instrumented/**
!instrumented/**/
!instrumented/**/*.cbl
!instrumented/**/*.json

# Generated test-generation prompts (rebuilt from the program + variable table)
testsuites/**/prompt.txt
